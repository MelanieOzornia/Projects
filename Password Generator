# Password Generator 
import random
import string

print("Password generator to keep you safe from hackers!!")
while True:
    length = int(input("How many characters do you want in your password? "))
    if length == 0:
        print("Please enter a valid length for your password.")
        continue
    else:
        (print("Thank you! Your password length is now ",length," characters.", sep=""))
        break
# asks users for character specifications they want for their password
# turns them into boolean values indicating whether each character type is included

UpCase = input("Do you want uppercase letters in your password? (yes/no): ").lower() == "yes"
DownCase = input("Do you want lowercase letters in your password? (yes/no): ").lower() == "yes"
Numbers = input("Do you want numbers in your password? (yes/no): ").lower() == "yes"
Symbols = input("Do you want symbols in your password? (yes/no): ").lower() == "yes"

# builds the character pool for the password to be built off of based on previous user inputs
CharacterPool = ""
if UpCase:
    CharacterPool += string.ascii_uppercase
if DownCase:
    CharacterPool += string.ascii_lowercase
if Numbers:
    CharacterPool += string.digits
if Symbols:
    CharacterPool += string.punctuation

#password variable (empty and will be filed with following loop)
password = ""

# generates the password by randomly selecting characters from the character pool
for i in range(length):
    password += random.choice(CharacterPool)
    
print("Your password is: ", password)

